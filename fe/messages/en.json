        },
        "pickupReminders": {
          "title": "Overdue pickup reminders",
          "description": "Notifies the sender (and receiver, if any) of stored orders past their pickup deadline; each order is reminded again only after the «reminder-cooldown-minutes» setting.",
          "frequency": "Every 10 minutes"
        },
        "releaseOverdue": {
          "title": "Move long-overdue orders to storage",
          "description": "Stored orders overdue longer than the «overdue-release-hours» setting: finalizes the overtime fee, moves them to EXPIRED (items go to storage), releases the box, revokes the PIN and notifies the customer.",
          "frequency": "Hourly at minute 05",
          "confirm": "Long-overdue orders become EXPIRED, get the overtime fee, lose their PIN and their box is released for other orders; customers are notified. This cannot be undone."
        },
        "reconcileBoxes": {
          "title": "Reconcile box states",
          "description": "Compares box states in locker-service with active orders: releases RESERVED/OCCUPIED boxes no order holds, and reclaims AVAILABLE boxes that still belong to an active order.",
          "frequency": "Hourly at minute 35",
          "confirm": "Box states across all lockers may be changed to match active orders. Prefer running it when no drop-off/pickup is in progress."
        }
      }
